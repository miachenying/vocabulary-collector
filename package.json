{
  "name": "vocabulary-collector",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:m3": "node --experimental-strip-types --test tests/vocabulary-m3.test.mjs",
    "eval:m3": "node --experimental-strip-types scripts/run-m3-evals.mjs",
    "test:m4": "node --experimental-strip-types --test tests/vocabulary-m4.test.mjs",
    "score:m4": "node scripts/score-m4-eval-results.mjs evals/m4-sentence-cases.json",
    "test:m5": "node --experimental-strip-types --test tests/vocabulary-m5.test.mjs",
    "test:m6": "node --experimental-strip-types --test tests/vocabulary-m6.test.mjs",
    "test:e2e:d1": "node scripts/run-d1-e2e.mjs",
    "test:e2e:browser": "node scripts/run-browser-e2e.mjs",
    "check:release": "npm run test:m3 && npm run test:m4 && npm run test:m5 && npm run test:m6",
    "check:runtime": "npm run check:release && npm test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Vocabulary Collector"
}
